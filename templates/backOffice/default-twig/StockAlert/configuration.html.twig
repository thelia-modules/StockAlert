<div class="mb-3 card">
	<div class="card-header">
		<h3 class="mb-0 card-title">{{ 'Configuration.'|trans({}, 'stockalert.bo.default') }}</h3>
	</div>
	<div class="card-body">
		{% if not stock_check_enabled %}
			<p class="alert alert-info">
				{{ 'The stock is not not use on the site. Please set the config variable check-available-stock to 1.'|trans({}, 'stockalert.bo.default') }}
			</p>
		{% endif %}
		{% form_theme form with bo_form_themes only %}
		{{ form_start(form, {'action': path('stockalert.config.save')}) }}
		{{ form_errors(form) }}
		{{form_rest(form) }}
		<button type="submit" id="stockalert-save" class="btn btn-primary">{{ 'Save'|trans({}, 'stockalert.bo.default') }}</button>
		{{ form_end(form) }}
	</div>
</div>

<div class="mb-3 card">
	<div class="card-header">
		<h3 class="mb-0 card-title">{{ 'List of current subscriptions.'|trans({}, 'stockalert.bo.default') }}</h3>
	</div>
	<div class="card-body">
		{% if subscriptions is not empty %}
			<div class="table-responsive">
				<table class="table table-striped" id="alert_list">
					<thead>
						<tr>
							<th>{{ 'Date'|trans({}, 'stockalert.bo.default') }}</th>
							<th>{{ 'Email'|trans({}, 'stockalert.bo.default') }}</th>
							<th>{{ 'Product'|trans({}, 'stockalert.bo.default') }}</th>
							<th class="actions">{{ 'Actions'|trans }}</th>
						</tr>
					</thead>
					<tbody>
						{% for subscription in subscriptions %}
							<tr>
								<td>{{ subscription.createDate ? subscription.createDate|date('Y-m-d') : '' }}</td>
								<td>{{ subscription.email }}</td>
								<td>
									{% if subscription.productId %}
										<a href="{{ path('admin.products.update', {'product_id': subscription.productId}) }}">{{ subscription.productId }}.
											{{ subscription.productTitle }}</a>
									{% endif %}
								</td>
								<td class="text-end">
									<form method="post" class="d-inline" action="{{ path('stockalert.config.delete', {'id': subscription.id}) }}&_token={{ assignToken() }}">
										<button type="submit" class="btn btn-danger btn-sm">
											<i class="bi bi-trash"></i>
										</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-warning">
				<p>{{ 'There is no subscriptions.'|trans({}, 'stockalert.bo.default') }}</p>
			</div>
		{% endif %}
	</div>
</div>
