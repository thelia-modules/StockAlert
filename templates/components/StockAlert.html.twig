{% form_theme form with flexy_form_themes only %}
<div {{ attributes.defaults({class: 'StockAlert flex flex-col gap-3'}) }}>
    {% if success %}
        <twig:Molecules:SnackBar:Base variant="success" withIcon text="{{ message }}" />
    {% else %}
        <p class="paragraph-3">{{ 'Tell me when it is back in stock'|trans({}, 'stockalert.fo.default') }}</p>

        {% if message %}
            <twig:Molecules:SnackBar:Base variant="error" withIcon text="{{ message }}" />
        {% endif %}

        {{ form_start(form, {attr: {
            class: 'flex flex-col gap-3',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
            novalidate: 'novalidate',
        }}) }}
            {# The sale element travels as a plain hidden input: the form theme would otherwise
               render the id type as a labelled field. #}
            <input type="hidden" name="{{ field_name(form.product_sale_elements_id) }}" value="{{ pseId }}">
            {% do form.product_sale_elements_id.setRendered %}
            {{ form_row(form.email, {label: 'Email address'|trans({}, 'stockalert.fo.default')}) }}
            {{ form_row(form.newsletter, {label: 'I would like to receive the newsletter or the latest news.'|trans({}, 'stockalert.fo.default')}) }}
            <twig:Molecules:Button:Base type="submit" text="{{ 'Alert me'|trans({}, 'stockalert.fo.default') }}" icon_left="bell" color="secondary" class="self-start" />
        {{ form_end(form) }}
    {% endif %}
</div>
