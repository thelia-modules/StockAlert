<div {{ attributes }}>
	<button class="self-start mb-4 Button Button--large open-modal" type="button" data-action="live#action" data-live-action-param="openModal">
		{{'Alert me'|trans}}
		<span class="icon icon-right">
			{{ ux_icon('bell') }}
		</span>
	</button>

	{% set stockAlertContent %}

	<legend class="h4">{{'Register your email to be notified when it will be available again.'|trans}}</legend>
	{% if message and success %}
		{% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {text: message, variant: 'validated', withIcon:true, size: "full my-8"} %}
		<button type="button" class="mx-auto Button Button--primary" data-action="modal#close">
			{{ 'Back to product'|trans }}
		</button>

	{% else %}
		{{form_start(form,{
		attr : {
			class: 'flex flex-col items-stretch gap-4 mt-4',
			'data-action': 'live#action:prevent',
			'data-live-action-param': 'save'
			}
		})}}


		<input type="hidden" name="{{ field_name(form.product_sale_elements_id) }}" value="{{ field_value(form.product_sale_elements_id) }}">
		{{form_rest(form)}}
		{{ component('Flexy:Button', {text: 'Confirm'|trans, size: 'large', type: 'submit', class: 'self-center'}) }}
		{{form_end(form)}}
	{% endif %}
	{% endset %}

	{% include '@components/Molecules/Modal/Modal.html.twig' with {
		name: 'stockAlert',
		content: stockAlertContent
	} %}
</div>
